# SwiftPM, Xcode, Gradle, and Skip build output (also applies to Example/).
.build/
.build-*/
.swiftpm/
build/
DerivedData/
.gradle/
.android/
.kotlin/
.cxx/
.externalNativeBuild/
Packages/
Package.pins
Carthage/Build/

# Keep Package.resolved, Skip.env, shared schemes, project files, and resources.
# Only machine-specific IDE and SDK configuration belongs here.
.DS_Store
._*
.idea/
xcuserdata/
local.properties
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
.*.swp
.*.swo
*~
*.orig
*.rej

# Raw test results, diagnostics, and coverage. Compact current summaries stay tracked.
*.log
*.xcresult/
*.profraw
*.profdata
*.gcda
*.gcno
*.hmap
*.exec
*.ec
/Documentation/Coverage/*/

# Compiled products and release packages, not source fixtures or demo media.
*.o
*.a
*.so
*.dylib
*.class
*.dex
*.apk
*.aab
*.aar
*.app/
*.ipa
*.xcarchive/
*.xcframework/
*.zip
*.tar
*.tar.gz
*.tgz
*.dSYM/
*.dSYM.zip

# Local credentials and signing material. Skip.env remains versioned.
.env
.env.*
!.env.example
!.env.sample
*.jks
*.keystore
keystore.properties
*.mobileprovision
*.cer
*.p12
*.p12.password

# Local campaign drafts and publishing assets are not package contents.
/Marketing/

# Generated playground and fastlane output.
timeline.xctimeline
playground.xcworkspace
**/fastlane/apikey.json
**/fastlane/report.xml
**/fastlane/README.md
**/fastlane/Preview.html
**/fastlane/test_output/
